+    JS::Rooted<JSObject*> global(cx, JS::CurrentGlobalOrNull(cx));
+    if (global) {
+      JS::Rooted<JS::Value> undef(cx, JS::UndefinedValue());
+      JS_SetProperty(cx, global, "setWebGLRenderer", undef);
+      JS_DeleteProperty(cx, global, "setWebGLRenderer");
+    }
+  }

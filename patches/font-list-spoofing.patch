diff --git a/dom/base/FontListManager.cpp b/dom/base/FontListManager.cpp
new file mode 100644
index 0000000..0115c02
--- /dev/null
+++ b/dom/base/FontListManager.cpp
@@ -0,0 +1,122 @@
+/* Camoufox: Per-context font list manager */
+#include "FontListManager.h"
+
+#include "mozilla/Mutex.h"
+#include "mozilla/dom/BrowsingContext.h"
+#include "js/Wrapper.h"
+#include "nsGlobalWindowInner.h"
+#include "xpcpublic.h"
+
+namespace mozilla {
+namespace dom {
+
+static Mutex sFontListMutex("FontListManager");
+static nsTHashMap<nsUint32HashKey, nsTHashSet<nsCString>> sFontLists;
+static thread_local uint32_t sCurrentContextId = 0;
+
+static nsGlobalWindowInner* ResolveWindowForWebIDL(JSContext* aCx,
+                                                   JSObject* aObj) {
+  if (!aObj) {
+    return xpc::CurrentWindowOrNull(aCx);
+  }
+  if (!js::IsWrapper(aObj)) {
+    if (nsGlobalWindowInner* win = xpc::WindowOrNull(aObj)) {
+      return win;
+    }
+    if (nsGlobalWindowInner* win = xpc::WindowGlobalOrNull(aObj)) {
+      return win;
+    }
+  }
+  if (nsGlobalWindowInner* win = xpc::SandboxWindowOrNull(aObj, aCx)) {
+    return win;
+  }
+  if (JSObject* unwrapped =
+          js::CheckedUnwrapDynamic(aObj, aCx, /* stopAtWindowProxy = */ false)) {
+    if (nsGlobalWindowInner* win = xpc::WindowOrNull(unwrapped)) {
+      return win;
+    }
+    if (nsGlobalWindowInner* win = xpc::WindowGlobalOrNull(unwrapped)) {
+      return win;
+    }
+  }
+  return xpc::CurrentWindowOrNull(aCx);
+}
+
+nsString FontListManager::DisabledKeyForUserContext(uint32_t aId) {
+  nsAutoString key;
+  key.AppendPrintf("fontlist_d_%u", aId);
+  return key;
+}
+
+void FontListManager::SetFontList(uint32_t aId, const nsAString& aFontList) {
+  nsTHashSet<nsCString> fontSet;
+  nsAutoString remaining(aFontList);
+  while (!remaining.IsEmpty()) {
+    int32_t commaPos = remaining.FindChar(',');
+    nsAutoString fontName;
+    if (commaPos >= 0) {
+      fontName = Substring(remaining, 0, commaPos);
+      remaining.Cut(0, commaPos + 1);
+    } else {
+      fontName = remaining;
+      remaining.Truncate();
+    }
+    fontName.Trim(" \t");
+    if (fontName.IsEmpty()) continue;
+    nsAutoCString utf8;
+    CopyUTF16toUTF8(fontName, utf8);
+    ToLowerCase(utf8);
+    fontSet.Insert(utf8);
+  }
+  MutexAutoLock lock(sFontListMutex);
+  sFontLists.InsertOrUpdate(aId, std::move(fontSet));
+}
+
+bool FontListManager::HasFontList(uint32_t aId) {
+  MutexAutoLock lock(sFontListMutex);
+  return sFontLists.Contains(aId);
+}
+
+bool FontListManager::IsFontAllowed(uint32_t aId,
+                                     const nsACString& aFontName) {
+  MutexAutoLock lock(sFontListMutex);
+  uint32_t effectiveId = aId;
+  if (!sFontLists.Contains(effectiveId)) {
+    if (effectiveId != 0 && sFontLists.Contains(0)) {
+      effectiveId = 0;
+    } else {
+      return true;
+    }
+  }
+  auto entry = sFontLists.Lookup(effectiveId);
+  if (!entry) return true;
+  return entry.Data().Contains(aFontName);
+}
+
+void FontListManager::SetCurrentContext(uint32_t aId) {
+  sCurrentContextId = aId;
+}
+
+uint32_t FontListManager::GetCurrentContext() {
+  return sCurrentContextId;
+}
+
+void FontListManager::DisableFunction(uint32_t aId) {
+  RoverfoxStorageManager::PutBool(DisabledKeyForUserContext(aId), true);
+}
+
+bool FontListManager::IsFunctionEnabledForWebIDL(JSContext* aCx,
+                                                  JSObject* aObj) {
+  nsGlobalWindowInner* win = ResolveWindowForWebIDL(aCx, aObj);
+  if (!win) return false;
+  uint32_t id = 0;
+  if (BrowsingContext* bc = win->GetBrowsingContext()) {
+    id = bc->OriginAttributesRef().mUserContextId;
+  }
+  bool disabled = false;
+  RoverfoxStorageManager::GetBool(DisabledKeyForUserContext(id), disabled);
+  return !disabled;
+}
+
+}  // namespace dom
+}  // namespace mozilla
diff --git a/dom/base/FontListManager.h b/dom/base/FontListManager.h
new file mode 100644
index 0000000..a83b0b0
--- /dev/null
+++ b/dom/base/FontListManager.h
@@ -0,0 +1,45 @@
+/* Camoufox: Per-context font list manager */
+#ifndef mozilla_dom_FontListManager_h
+#define mozilla_dom_FontListManager_h
+
+#include "nsString.h"
+#include "nsTHashMap.h"
+#include "nsHashKeys.h"
+#include "nsTHashSet.h"
+#include "RoverfoxStorageManager.h"
+
+namespace mozilla {
+namespace dom {
+
+class FontListManager {
+ public:
+  static void SetFontList(uint32_t aUserContextId, const nsAString& aFontList);
+  static bool HasFontList(uint32_t aUserContextId);
+  static bool IsFontAllowed(uint32_t aUserContextId,
+                             const nsACString& aFontName);
+  static void SetCurrentContext(uint32_t aUserContextId);
+  static uint32_t GetCurrentContext();
+  static void DisableFunction(uint32_t aId);
+  static bool IsFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+ private:
+  static nsString DisabledKeyForUserContext(uint32_t aId);
+};
+
+// RAII guard for setting/clearing the thread-local context
+class MOZ_RAII AutoFontListContext {
+ public:
+  explicit AutoFontListContext(uint32_t aId)
+      : mOldId(FontListManager::GetCurrentContext()) {
+    FontListManager::SetCurrentContext(aId);
+  }
+  ~AutoFontListContext() {
+    FontListManager::SetCurrentContext(mOldId);
+  }
+ private:
+  uint32_t mOldId;
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_FontListManager_h
